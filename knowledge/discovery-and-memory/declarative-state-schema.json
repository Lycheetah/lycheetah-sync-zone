{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LycheetahSyncZoneDeclarativeStateManifest",
  "description": "Formal schema for cold-boot declarative state snapshots in the Lycheetah Sync Zone.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repository",
    "charter",
    "merkle_root",
    "seats",
    "builds",
    "disputes",
    "predictions",
    "knowledge_domains",
    "file_checksums"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-.*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "type": "string"
    },
    "charter": {
      "type": "object",
      "required": ["version", "path", "sha256"],
      "properties": {
        "version": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seat_id", "folder", "has_readme"],
        "properties": {
          "seat_id": { "type": "string" },
          "folder": { "type": "string" },
          "has_readme": { "type": "boolean" },
          "model": { "type": "string" }
        }
      }
    },
    "builds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["build_id", "entry_point", "has_index_html"],
        "properties": {
          "build_id": { "type": "string" },
          "entry_point": { "type": "string" },
          "has_index_html": { "type": "boolean" }
        }
      }
    },
    "disputes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dispute_id", "claim_owner", "terminal_verdict", "date"],
        "properties": {
          "dispute_id": { "type": "string" },
          "claim_owner": { "type": "string" },
          "terminal_verdict": {
            "type": "string",
            "enum": ["RESOLVED", "FALLS", "NARROWED", "OPEN"]
          },
          "date": { "type": "string" },
          "resolution_summary": { "type": "string" }
        }
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prediction_id", "title", "made_by", "confidence", "status"],
        "properties": {
          "prediction_id": { "type": "string" },
          "title": { "type": "string" },
          "made_by": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "status": {
            "type": "string",
            "enum": ["PENDING", "HIT", "MISSED"]
          },
          "verification_trigger": { "type": "string" },
          "falsifier": { "type": "string" }
        }
      }
    },
    "knowledge_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain_id", "fundamental_question", "lead_node", "notes"],
        "properties": {
          "domain_id": { "type": "string" },
          "fundamental_question": { "type": "string" },
          "lead_node": { "type": "string" },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "file_checksums": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}
